> /* แปลง error code จาก RPC เป็นข้อความที่อ่านรู้เรื่อง (ระบุสาเหตุจริง ไม่ใช่ "เพิ่มผู้ใช้ไม่ได้") */
> const _userBusy = new Set();
> function _userRpcMsg(e){
>   const raw = String((e && (e.message || e.details || e.hint)) || '');
>   if(/permission_denied/.test(raw))            return 'ไม่มีสิทธิ์: เฉพาะ SUPER ADMIN เท่านั้น (permission_denied)';
>   const dup = raw.match(/username_already_exists:?\s*(\S*)/);
>   if(dup)                                      return 'Username นี้ถูกใช้แล้ว: '+(dup[1]||'')+' (username_already_exists)';
>   const role = raw.match(/invalid_role:?\s*(\S*)/);
>   if(role)                                     return 'บทบาทไม่ถูกต้อง: '+(role[1]||'')+' (invalid_role)';
>   const st = raw.match(/invalid_status:?\s*(\S*)/);
>   if(st)                                       return 'สถานะไม่ถูกต้อง: '+(st[1]||'')+' (invalid_status)';
>   const miss = raw.match(/missing_required_field:?\s*(\S*)/);
>   if(miss)                                     return 'กรอกข้อมูลไม่ครบ: '+(miss[1]||'')+' (missing_required_field)';
>   if(/user_not_found/.test(raw))               return 'ไม่พบบัญชีนี้ (user_not_found)';
>   if(/Could not find the function|PGRST202/.test(raw))
>     return 'ยังไม่ได้ติดตั้ง RPC จัดการผู้ใช้ — รันไฟล์ sql/030_user_admin_rpc.sql ก่อน';
>   return raw || 'บันทึกไม่สำเร็จ';
> }
> 
> async function saveUser(editId){
>   if(!isSuper()){ toast('เฉพาะ SUPER ADMIN เท่านั้นที่จัดการผู้ใช้ได้','error'); return; }
>   const full_name = $('u-name').value.trim();
>   const username  = $('u-username') ? $('u-username').value.trim() : '';
>   const password  = $('u-password') ? $('u-password').value : '';
>   const status    = $('u-status').value || 'active';
>   const department= $('u-dept').value || null;
>   const role      = $('u-role').value || 'STAFF';
>   const termsArr  = Array.from(document.querySelectorAll('.u-term-chk:checked')).map(c=>c.value);
>   const terminals = termsArr.length ? termsArr.join(', ') : null;
> 
>   if(!full_name){ toast('กรอกชื่อ-สกุล','error'); return; }
>   if(!editId && !username){ toast('กรอก Username','error'); return; }
>   if(!editId && !password){ toast('ตั้งรหัสผ่าน','error'); return; }
>   if(USER_ROLES.indexOf(String(role).toUpperCase())<0){ toast('บทบาทไม่ถูกต้อง','error'); return; }
> 
>   const key = editId || ('new:'+username);
>   if(_userBusy.has(key)) return;                       // กันกดซ้ำ / INSERT ซ้ำ
>   _userBusy.add(key);
> 
>   const btn=$('u-save'); if(btn){ btn.disabled=true; btn.innerHTML='<span class="spinner"></span> บันทึก...'; }
>   try{
>     if(editId){
>       const { error } = await sb.rpc('sfz_admin_update_user', {
>         p_actor_id: String((S.user&&S.user.id)||''), p_app_code: LOGIN_APP_CODE,
>         p_user_id: String(editId), p_full_name: full_name, p_department: department,
>         p_role: role, p_status: status, p_password: password || null,
>         p_terminals: terminals, p_set_terminals: true
>       });
>       if(error) throw error;
>       toast('บันทึกการแก้ไขแล้ว','success');
>     }else{
>       const colors=['#0EA672','#3B82F6','#A855F7','#F59E0B','#EF4444','#14B8A6','#F97316'];
>       const { error } = await sb.rpc('sfz_admin_create_user', {
>         p_actor_id: String((S.user&&S.user.id)||''), p_app_code: LOGIN_APP_CODE,
>         p_username: username, p_password: password, p_full_name: full_name,
>         p_department: department, p_role: role, p_status: status,
>         p_terminals: terminals, p_avatar: colors[Math.floor(Math.random()*colors.length)]
>       });
>       if(error) throw error;
>       toast('เพิ่มผู้ใช้สำเร็จ','success');
>     }
>     closeModal('modal-form');
>     _shipSetsCache=null;                               // รายชื่อเปลี่ยน → ล้าง cache map ผู้ใช้
>     await loadUsersData();                             // reload เฉพาะรายชื่อผู้ใช้
>     renderUsers();
>   }catch(e){
>     console.error('[saveUser]', e);
>     toast(_userRpcMsg(e),'error');
>   }finally{
>     _userBusy.delete(key);
>     if(btn){ btn.disabled=false; btn.innerHTML='<i data-lucide="check"></i> บันทึก'; refreshIcons(); }
>   }
> }
